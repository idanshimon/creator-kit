{
  "name": "studio-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Local video-editing workspace UI for Creator Kit. Static React bundle served same-origin by the parent Python server on http://localhost:4318.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist .test-build",
    "build:test": "esbuild src/lib/timeline.ts --bundle --format=esm --platform=node --outfile=.test-build/timeline.mjs",
    "pretest": "npm run build:test",
    "test": "node --test",
    "build": "node build.mjs",
    "dev": "node build.mjs --watch"
  },
  "dependencies": {
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "0.24.2",
    "playwright-core": "1.63.0",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
