# Copy to .env (git-ignored). creator.py loads it and never overrides real env vars.

# Azure Speech narration with a key (narrate --engine azure --allow-cloud).
# Leave both empty to use Entra sign-in via `az` + --inventory instead.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional: location of an F5-TTS say.py for --engine f5
CREATOR_F5_SAY=

# Optional: PyPI mirror for the local voice runtime (qwen3/chatterbox); empty = pypi.org
CREATOR_PIP_INDEX=
