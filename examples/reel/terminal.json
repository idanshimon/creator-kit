{
  "template": "terminal",
  "format": "9:16",
  "style": "noir",
  "kicker": "CLI DEMO",
  "title": "One command. *Zero* editing.",
  "windowTitle": "~/creator-kit — zsh",
  "handle": "@creatorkit",
  "beats": [
    {
      "cmd": "creator.py reel --spec demo.json -o out",
